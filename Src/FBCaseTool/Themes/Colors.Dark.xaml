<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <!-- Fluent Clean · Dark theme tokens. Same keys as Colors.Light.xaml. -->

   <Color x:Key="Color.Accent">#3B82F6</Color>

   <!-- Surfaces -->
   <SolidColorBrush x:Key="Brush.Window"        Color="#1B1E24" />
   <SolidColorBrush x:Key="Brush.Surface"       Color="#252A33" />
   <SolidColorBrush x:Key="Brush.SurfaceMuted"  Color="#2E343E" />

   <!-- Lines -->
   <SolidColorBrush x:Key="Brush.Border"        Color="#3A404B" />
   <SolidColorBrush x:Key="Brush.BorderStrong"  Color="#4A515E" />

   <!-- Text -->
   <SolidColorBrush x:Key="Brush.Text"          Color="#E6E8EC" />
   <SolidColorBrush x:Key="Brush.TextMuted"     Color="#9AA3B2" />

   <!-- Accent -->
   <SolidColorBrush x:Key="Brush.Accent"        Color="#3B82F6" />
   <SolidColorBrush x:Key="Brush.AccentHover"   Color="#5B96F7" />
   <SolidColorBrush x:Key="Brush.AccentPressed" Color="#2D6FE0" />
   <SolidColorBrush x:Key="Brush.AccentText"    Color="#FFFFFF" />

   <!-- Alerts -->
   <SolidColorBrush x:Key="Brush.InfoBg"  Color="#173049" />
   <SolidColorBrush x:Key="Brush.InfoFg"  Color="#9CC6EE" />
   <SolidColorBrush x:Key="Brush.InfoBar" Color="#3B82F6" />
   <SolidColorBrush x:Key="Brush.WarnBg"  Color="#3D3316" />
   <SolidColorBrush x:Key="Brush.WarnFg"  Color="#E7C878" />
   <SolidColorBrush x:Key="Brush.WarnBar" Color="#C9A227" />

   <!-- Interaction overlays. Hover lightens on dark. -->
   <SolidColorBrush x:Key="Brush.HoverOverlay"   Color="#1FFFFFFF" />
   <SolidColorBrush x:Key="Brush.PressedOverlay" Color="#33FFFFFF" />
   <SolidColorBrush x:Key="Brush.DarkenHover"   Color="#1F000000" />
   <SolidColorBrush x:Key="Brush.DarkenPressed" Color="#33000000" />
</ResourceDictionary>
