<Application x:Class="FBCaseTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <Application.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <!-- Slot 0 is the active colour set; App.OnStartup swaps it for Colors.Dark.xaml
                 when Windows is in dark mode. Controls.xaml reads tokens via DynamicResource. -->
            <ResourceDictionary Source="Themes/Colors.Light.xaml" />
            <ResourceDictionary Source="Themes/Controls.xaml" />
         </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
   </Application.Resources>
</Application>
